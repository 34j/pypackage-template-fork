[build-system]
build-backend = "setuptools.build_meta"
requires = [ "setuptools>=77.0.3" ]

[project]
name = "{{ project_slug }}"
version = "0.0.0"
description = "{{ project_short_description }}"
readme = "README.md"
{%- if open_source_license != "Not open source" %}
license = "{{ open_source_license }}"
{%- endif %}
authors = [
  { name = "{{ user_name }}" },
]
requires-python = ">=3.12"
classifiers = [
  "Development Status :: 2 - Pre-Alpha",
  "Intended Audience :: Developers",
  "Natural Language :: English",
  "Operating System :: OS Independent",
  "Programming Language :: Python :: 3 :: Only",
  "Programming Language :: Python :: 3.12",
  "Programming Language :: Python :: 3.13",
  "Programming Language :: Python :: 3.14",
  "Topic :: Software Development :: Libraries",
]
{%- if has_cli  %}
dependencies = [
  "cyclopts",
]
{%- endif  %}
urls."Bug Tracker" = "https://github.com/{{ github_user }}/{{ project_slug }}/issues"
urls.Changelog = "https://github.com/{{ github_user }}/{{ project_slug }}/blob/main/CHANGELOG.md"
{%- if documentation %}
urls.documentation = "https://{{ project_slug }}.readthedocs.io"
{%- endif %}
urls.repository = "https://github.com/{{ github_user }}/{{ project_slug }}"
{%- if has_cli %}
scripts.{{ project_slug }} = "{{ module_name }}.cli:app"
{%- endif  %}

[dependency-groups]
dev = [
  "coverage",
  "packaging-34j[test]",
  "pytest",
  "pytest-cov",
  "ty",
]
{%- if documentation %}
docs = [
  "packaging-34j[docs]",
]
{%- endif %}

[tool.ruff]
extend = ".venv/lib/python3.13/site-packages/packaging_34j/ruff.toml"

[tool.pyproject-fmt]
max_supported_python = "3.14"

[tool.ty]
terminal.error-on-warning = true
