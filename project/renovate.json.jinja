{
{%- if github_username == "browniebroke" %}
  "extends": ["github>browniebroke/renovate-configs:python"]
{%- else  %}
  "extends": [
    "config:best-practices",
    ":pinOnlyDevDependencies",
    ":automergeAll",
    ":enablePreCommit"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["python"],
      "rangeStrategy": "widen",
      "separateMultipleMinor": true
    }
  ]
{%- endif  %}
}
